# Public site
RELAY_SITE_URL=https://relay.devkartikey.com

# Netlify → Site settings → Environment variables
# From-address domain must be Verified in Resend (you have relay.devkartikey.com)
RESEND_API_KEY=re_xxxxxxxx
RELAY_SMTP_FROM=RELAY <sayhello@relay.devkartikey.com>
RELAY_SMTP_REPLY_TO=sayhello@relay.devkartikey.com

# Local Python server only (optional)
# RELAY_HOST=0.0.0.0
# RELAY_SMTP_HOST=smtp.your-provider.com
# RELAY_SMTP_PORT=587
# RELAY_SMTP_USER=sayhello@devkartikey.com
# RELAY_SMTP_PASS=

