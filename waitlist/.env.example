# Public site
RELAY_SITE_URL=https://relay.devkartikey.com

# Netlify → Site configuration → Environment variables
RESEND_API_KEY=re_xxxxxxxx
RELAY_SMTP_FROM=RELAY <sayhello@relay.devkartikey.com>
RELAY_SMTP_REPLY_TO=sayhello@relay.devkartikey.com
# RELAY_NOTIFY_TO=you@gmail.com

# Admin panel → https://relay.devkartikey.com/admin
ADMIN_PASSWORD=choose-a-strong-password

# Required for saving signups/visits (Netlify Blobs)
# Site ID: Netlify → Site configuration → General → Site details → Site ID
# Token: https://app.netlify.com/user/applications → Personal access tokens
NETLIFY_SITE_ID=your-site-id
NETLIFY_AUTH_TOKEN=your-personal-access-token

